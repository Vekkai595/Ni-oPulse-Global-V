# NOAA cache durations (milliseconds)
NOAA_CACHE_TTL_MS=600000
HISTORY_CACHE_TTL_MS=21600000

# Optional public API authentication. JSON maps client label -> key/configuration.
# Example: {"school-lab":{"key":"research-key-1","limit":600},"partner":"research-key-2"}
NINOPULSE_API_KEYS=

# Legacy single shared key (optional; prefer NINOPULSE_API_KEYS)
NINOPULSE_API_KEY=

# Optional distributed rate limiting on Vercel/production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
